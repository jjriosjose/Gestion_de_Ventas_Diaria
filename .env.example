# Nunca uses service_role ni secretos de Supabase en el navegador.
#
# PRODUCCIÓN
# La URL/key productiva están fijadas en src/lib/supabase.ts y solo se usan
# automáticamente en el host canónico:
# https://gestion-de-ventas-diaria.jjriosjose.workers.dev
#
# QA / DESARROLLO
# Crea .env.local (está ignorado por Git) y configura aquí una base Supabase
# Development Branch o proyecto QA independiente.
#
# Mientras estas dos variables NO estén configuradas, localhost puede leer
# producción para revisión, pero cualquier escritura queda BLOQUEADA.
#
# IMPORTANTE: VITE_SUPABASE_QA_URL nunca puede apuntar al proyecto productivo
# ccvzosnhxitfeochnflr; el cliente lo rechazará y permanecerá en modo lectura segura.

VITE_SUPABASE_QA_URL=
VITE_SUPABASE_QA_PUBLISHABLE_KEY=
